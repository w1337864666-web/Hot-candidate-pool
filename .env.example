# Never commit the real .env file or your API key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://your-proxy.example.com/v1
OPENAI_MODEL=gpt-4o-mini
MODEL_API_ENABLED=1
MODEL_SCORING_ENABLED=1
MODEL_CONTENT_ENABLED=1
MODEL_CANDIDATE_LIMIT=12

# Optional supplemental news search. It is skipped when the key is empty.
TAVILY_API_KEY=
DATA_API_ENABLED=1

# Optional network proxy for RSS/Atom and OpenAI requests.
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
